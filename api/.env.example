# Copy to api/.env. Do not put real secrets in git.
# The API reads this file when uvicorn is started from the api directory.

API_PORT=8010
WEB_PORT=3010
# Jobs database. Leave unset on the Mac: API and worker share worker/data/jobs.sqlite.
# Railway sets DATABASE_URL from the Postgres service on both the API and the worker.
# DATABASE_URL=
REDIS_URL=redis://localhost:6380/0

# Academy OIDC issuer. Issuer must match Academy OIDC_ISSUER, including the trailing slash.
# Audience must match the job-web client audience (no trailing slash).
OIDC_ISSUER=http://127.0.0.1:8000/
OIDC_AUDIENCE=http://127.0.0.1:8010
OIDC_JWKS_URL=http://127.0.0.1:8000/portal/oauth/jwks.json
OIDC_CLIENT_ID=job-web
OIDC_AUTHORIZE_URL=http://127.0.0.1:8000/portal/oauth/authorize
OIDC_TOKEN_URL=http://127.0.0.1:8000/portal/oauth/token
OIDC_REDIRECT_URIS=http://localhost:3010/api/auth/callback,http://127.0.0.1:3010/api/auth/callback

# Next.js reads these from the environment (frontend/.env.local or the shell).
# Defaults match the values above, so local dev works without copying them.
# There is no client secret: job-web is a public PKCE client.
# JOB_OIDC_ISSUER=http://127.0.0.1:8000/
# JOB_OIDC_CLIENT_ID=job-web
# JOB_OIDC_AUTHORIZE_URL=http://127.0.0.1:8000/portal/oauth/authorize
# JOB_OIDC_LOGOUT_URL=  # Ignored. Logout must not call Academy or start a new login.
# JOB_API_BASE_URL=http://127.0.0.1:8010
# NEXT_PUBLIC_APP_URL=http://localhost:3010

# Academy side, in ingress-academy/.env (not secrets):
# OIDC_ISSUER=http://127.0.0.1:8000/
# OIDC_JOB_AUDIENCE=http://127.0.0.1:8010
# OIDC_JOB_REDIRECT_URIS=http://localhost:3010/api/auth/callback,http://127.0.0.1:3010/api/auth/callback
# Then: python manage.py migrate && python manage.py sync_oidc_job_client

# Worker skips these APIs when the variable is missing. Do not put a real key in git.
# JOOBLE_API_KEY=
# REED_API_KEY=

# File storage. Same names as ingress-academy. Leave unset on the Mac: CVs stay in api/data/cvs/.
# BUCKET_NAME=
# BUCKET_ACCESS_KEY=
# BUCKET_SECRET_KEY=
# BUCKET_REGION=
# BUCKET_ENDPOINT=

# Sentry. Empty DSN means nothing is sent. Same names as ingress-academy.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# DEBUG=True

# OpenTelemetry. Academy does not define these. Export starts only when the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=
# OTEL_TRACES_SAMPLER_ARG=
# OTEL_SDK_DISABLED=

# Optional sqlite path, only when DATABASE_URL is unset. Default is worker/data/jobs.sqlite.
# JOBS_DB_PATH=

# Email. Same names as ingress-academy. Leave EMAIL_HOST unset on the Mac:
# the in-site notification is still saved and the request does not crash.
# The From display name is Ingress Job. The address is DEFAULT_FROM_EMAIL, or EMAIL_HOST_USER.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=20
# DEFAULT_FROM_EMAIL=

# Marketing digests / high-match alerts (plan §8). Worker POSTs to the API when set.
# INTERNAL_JOB_TOKEN=
# EMAIL_UNSUBSCRIBE_SECRET=
# HIGH_MATCH_MIN_SCORE=0.75
# NEXT_PUBLIC_ACADEMY_COURSE_BASE=https://ingress.academy/trainings/
# ACADEMY_CAREER_PATH_BASE=https://ingress.academy/career-paths/
# NEXT_PUBLIC_ACADEMY_CAREER_PATH_BASE=https://ingress.academy/career-paths/
# Digest AI #4 personal intro (API process; needs OPENAI_API_KEY / AI_GATEWAY_*).
# OPENAI_API_KEY=
# AI_GATEWAY_ENABLED=1
# AI_GATEWAY_MODEL=gpt-4.1-nano
# AI_GATEWAY_DAILY_CALL_LIMIT=200
# DIGEST_AI_INTRO_ENABLED=1
