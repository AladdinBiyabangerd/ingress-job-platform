{
  "manifest_version": 3,
  "name": "Ingress Job – LinkedIn qeyd",
  "version": "0.1.0",
  "description": "Start/Stop: baxdığınız LinkedIn elanlarını toplayıb Ingress Job platformasına göndərir.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3010/*",
    "http://127.0.0.1:3010/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ingress Job",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}