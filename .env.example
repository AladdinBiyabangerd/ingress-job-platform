API_PORT=8010
WEB_PORT=3010
# Jobs database. Leave unset on the Mac: API and worker share worker/data/jobs.sqlite.
# Railway sets DATABASE_URL from the Postgres service on both the API and the worker.
# DATABASE_URL=
REDIS_URL=redis://localhost:6380/0
# Rate limits (api + web). Off locally unless set to 1; on when RAILWAY_ENVIRONMENT is set.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_FAIL_CLOSED=0
# FORWARDED_ALLOW_IPS=127.0.0.1
# ALLOWED_HOSTS=
# MAX_REQUEST_BODY_BYTES=6291456
# CABINET_MAX_ADS_PER_DAY=30
# Cloudflare Turnstile (login + job create when secret set)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional Academy refresh revoke on logout
# JOB_OIDC_REVOKE_URL=
OIDC_ISSUER=http://127.0.0.1:8000/
OIDC_AUDIENCE=http://127.0.0.1:8010
OIDC_JWKS_URL=http://127.0.0.1:8000/portal/oauth/jwks.json
OIDC_CLIENT_ID=job-web
# Same value as Academy OIDC_JOB_CLIENT_SECRET. API-only — never put in the frontend.
OIDC_CLIENT_SECRET=change-me-local-job-oidc-secret
OIDC_AUTHORIZE_URL=http://127.0.0.1:8000/portal/oauth/authorize
OIDC_TOKEN_URL=http://127.0.0.1:8000/portal/oauth/token
OIDC_REDIRECT_URIS=http://localhost:3010/api/auth/callback,http://127.0.0.1:3010/api/auth/callback

# Worker skips these APIs when the variable is missing. Do not put a real key in git.
# JOOBLE_API_KEY=
# Jooble key allows 500 requests in total: monthly stop (default 450) and queries per pass (default 3).
# JOOBLE_MONTHLY_BUDGET=450
# JOOBLE_MAX_QUERIES=3
# REED_API_KEY=
# Reed soft monthly request cap (no published limit) and searches per pass (default 5).
# REED_MONTHLY_BUDGET=3000
# REED_MAX_QUERIES=5
# HH_API_KEY=

# OpenAI (job-text tidy + CV AI #1 + digest AI #4 via ai_gateway). Leave empty so nothing is sent.
# Daily on/off per flow is Moderasiya → AI axınları (jobs DB). Env 0 is still a hard off.
# OPENAI_API_KEY=
# AI_GATEWAY_ENABLED=1
# AI_GATEWAY_MODEL=gpt-4.1-nano
# AI_GATEWAY_DAILY_CALL_LIMIT=200
# Worker hourly job embeddings (default 250, max 500). NVIDIA hosted RPM is fine at this rate.
# EMBED_STALE_LIMIT=250
# CV_AI_FALLBACK_ENABLED=1
# CV_AI_LOW_CONFIDENCE=0.55
# DIGEST_AI_INTRO_ENABLED=1
# Engagement notification AI copy: default on when OPENAI_API_KEY is set; set 0 to force off.
# ENGAGEMENT_AI_COPY_ENABLED=0
# Crawl market fit (unclear remote/reloc): default on when any chat key is set; set 0 to force off.
# Provider order: gemini → groq → nvidia → openrouter → openai (AI_CHAT_PROVIDERS).
# Gemini free-tier: cascades all text-out models; optional second key.
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEYS=key1,key2
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.8-flash
# GEMINI_MODEL=  (legacy single-model override if GEMINI_MODELS unset)
# NVIDIA_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-20b,google/gemma-4-31b-it,z-ai/glm-5.3,nvidia/nemotron-3-super-120b-a12b
# NVIDIA_CHAT_MODEL=  (legacy single-model override if NVIDIA_MODELS unset)
# GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEYS=key1,key2
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
# GROQ_MODEL=  (legacy single-model override if GROQ_MODELS unset)
# AI_MARKET_FIT_ENABLED=0

# File storage. Same names as ingress-academy. Leave unset on the Mac: CVs stay in api/data/cvs/.
# BUCKET_NAME=
# BUCKET_ACCESS_KEY=
# BUCKET_SECRET_KEY=
# BUCKET_REGION=
# BUCKET_ENDPOINT=

# Sentry. Empty DSN means nothing is sent. Same names as ingress-academy.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# DEBUG=True

# OpenTelemetry. Academy does not define these. Export starts only when the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=
# OTEL_TRACES_SAMPLER_ARG=
# OTEL_SDK_DISABLED=

# Optional sqlite path, only when DATABASE_URL is unset. Default is worker/data/jobs.sqlite.
# JOBS_DB_PATH=

# Email. Same names as ingress-academy. Leave EMAIL_HOST unset on the Mac:
# the in-site notification is still saved and the request does not crash.
# The From display name is Ingress Job. The address is DEFAULT_FROM_EMAIL, or EMAIL_HOST_USER.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=20
# DEFAULT_FROM_EMAIL=

# Chrome extension (extension/) imports LinkedIn ads via POST /api/v1/import/linkedin-jobs.
# Without a token the endpoint answers 503. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# JOB_IMPORT_TOKEN=

# Marketing digests / high-match alerts (plan §8). Worker POSTs to the API when set.
# Same INTERNAL_JOB_TOKEN on api + worker; without it hourly engagement/email jobs are skipped.
# INTERNAL_JOB_TOKEN=
# EMAIL_UNSUBSCRIBE_SECRET=
# HIGH_MATCH_MIN_SCORE=0.75
# ENGAGEMENT_LOOKBACK_HOURS=72
# Academy course / career-path deep-links (optional).
# NEXT_PUBLIC_ACADEMY_COURSE_BASE=https://ingress.academy/trainings/
# NEXT_PUBLIC_ACADEMY_CAREER_PATH_BASE=https://ingress.academy/career-paths/

# Parked product surfaces (default off). Set to 1 on API + web to re-enable.
# PRODUCT_RECOMMENDATIONS_ENABLED=0
# PRODUCT_ROADMAP_ENABLED=0
# PRODUCT_EMPLOYER_POSTING_ENABLED=0
# NEXT_PUBLIC_PRODUCT_RECOMMENDATIONS_ENABLED=0
# NEXT_PUBLIC_PRODUCT_ROADMAP_ENABLED=0
# NEXT_PUBLIC_PRODUCT_EMPLOYER_POSTING_ENABLED=0

# Web Push (API). Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
